<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    {% assign news = site.news | reverse %}
    {% if include.limit and page.announcements.limit %}
      {% assign news_limit = page.announcements.limit %}
    {% else %}
      {% assign news_limit = news_size %}
    {% endif %}
    {% capture news_rows %}
      {% for item in news limit: news_limit %}
        <tr>
          <th scope="row" style="width: 15%; color: red;">{{ item.date | date: '%b %d, %Y' }}</th>
          <td>
            {% if item.inline %}
              {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
            {% else %}
              <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
            {% endif %}
          </td>
        </tr>
      {% endfor %}
    {% endcapture %}

    {% if include.limit and page.announcements.scrollable and news_size > 3 %}
      <div class="news-carousel" aria-label="Latest news" tabindex="0">
        <div class="news-carousel-track">
          <table class="table table-sm table-borderless">
            <tbody>{{ news_rows }}</tbody>
          </table>
          <table class="table table-sm table-borderless" aria-hidden="true" inert>
            <tbody>{{ news_rows }}</tbody>
          </table>
        </div>
      </div>
    {% else %}
      <div class="table-responsive">
        <table class="table table-sm table-borderless">
          <tbody>{{ news_rows }}</tbody>
        </table>
      </div>
    {% endif %}
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
